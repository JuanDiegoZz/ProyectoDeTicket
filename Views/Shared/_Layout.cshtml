@using System.Security.Claims
@using TicketsApp.Domain.Enums
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Soporte TI | TecNM Monclova</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Estilos personalizados TecNM -->
    <link rel="stylesheet" href="~/css/custom.css?v=@DateTime.UtcNow.Ticks" />
</head>
<body>
    <!-- HEADER SUPERIOR INSTITUCIONAL -->
    <header class="bg-white border-bottom py-2 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <img src="~/img/logo-limpio.png?v=@DateTime.UtcNow.Ticks" alt="TecNM Logo" height="42" />
                <div class="border-start border-2 ps-3 py-1">
                    <span class="fw-bold text-dark d-block" style="font-size: 0.95rem; letter-spacing: 0.3px;">TECNOLÓGICO NACIONAL DE MÉXICO</span>
                    <small class="text-muted" style="font-size: 0.75rem;">Instituto Tecnológico Superior de Monclova &bull; Centro de Cómputo e Informática</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-light text-secondary border px-3 py-2">
                    <i class="bi bi-clock me-1 text-primary"></i>Mesa de Ayuda TI: 8:00 - 18:00 hrs
                </span>
                <button id="btnToggleDark" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Cambiar Tema">
                    <i class="bi bi-moon-stars me-1" id="iconDark"></i>Tema
                </button>
            </div>
        </div>
    </header>

    <!-- NAVBAR PRINCIPAL RESPONSIVO -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-tecnm py-2 sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Tickets" asp-action="Index">
                <img src="~/img/logo-limpio.png?v=@DateTime.UtcNow.Ticks" alt="TecNM Logo" height="34" class="me-2" />
                <div class="d-flex align-items-center">
                    <div>
                        <span class="fw-bold text-white d-block" style="font-size: 1.05rem; letter-spacing: 0.5px;">SOPORTE TI</span>
                        <small class="text-white-50 d-none d-sm-block" style="font-size: 0.7rem;">Campus Monclova</small>
                    </div>
                </div>
            </a>
            
            <div class="d-flex align-items-center d-md-none gap-2">
                <button id="btnToggleDarkMobile" class="btn btn-sm btn-outline-light rounded-circle" style="width: 34px; height: 34px; padding: 0;">
                    <i class="bi bi-moon-stars" id="iconDarkMobile"></i>
                </button>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-1">
                            <a class="nav-link nav-link-custom" asp-controller="Tickets" asp-action="Index">
                                <i class="bi bi-grid-fill me-1 text-warning"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item me-1">
                            <a class="nav-link nav-link-custom" asp-controller="Tickets" asp-action="Crear">
                                <i class="bi bi-plus-circle-fill me-1 text-warning"></i>Nuevo Reporte
                            </a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="GestionTecnicos">
                                    <i class="bi bi-person-badge-fill me-1 text-warning"></i>Técnicos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Catalogos" asp-action="Categorias">
                                    <i class="bi bi-tags-fill me-1 text-warning"></i>Categorías
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Catalogos" asp-action="Ubicaciones">
                                    <i class="bi bi-geo-alt-fill me-1 text-warning"></i>Ubicaciones
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle nav-link-custom d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <div class="bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center me-2 shadow-sm" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="text-start">
                                    <div class="fw-bold text-white small">@User.Identity.Name</div>
                                    <div class="text-white-50" style="font-size: 0.7rem;">@User.FindFirst(ClaimTypes.Role)?.Value</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block">Usuario Conectado:</small>
                                    <span class="fw-bold small text-dark d-block">@User.Identity.Name</span>
                                    <span class="small text-muted">@User.FindFirst(ClaimTypes.Email)?.Value</span>
                                </li>
                                <li class="p-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2">
                                            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Ingresar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-tecnm-gold btn-sm px-3" asp-controller="Account" asp-action="Registro">
                                <i class="bi bi-person-plus-fill me-1"></i>Registrarse
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4 main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <img src="~/img/logo-limpio.png?v=@DateTime.UtcNow.Ticks" alt="TecNM" height="26" />
                <span>Instituto Tecnológico Superior de Monclova &copy; @DateTime.UtcNow.Year</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border">Mesa de Ayuda TI v2.0 (.NET 10)</span>
                <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-shield-lock-fill me-1"></i>Conexión Segura</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        (function() {
            const currentTheme = localStorage.getItem('tecnm_theme') || 'light';
            if (currentTheme === 'dark') {
                document.body.classList.add('dark-mode');
            }

            function updateIcons(isDark) {
                const icon = document.getElementById('iconDark');
                const iconMobile = document.getElementById('iconDarkMobile');
                if (icon) icon.className = isDark ? 'bi bi-sun-fill me-1 text-warning' : 'bi bi-moon-stars me-1';
                if (iconMobile) iconMobile.className = isDark ? 'bi bi-sun-fill text-warning' : 'bi bi-moon-stars';
            }

            function toggleTheme() {
                const isDark = document.body.classList.toggle('dark-mode');
                localStorage.setItem('tecnm_theme', isDark ? 'dark' : 'light');
                updateIcons(isDark);
            }

            document.addEventListener('DOMContentLoaded', () => {
                updateIcons(document.body.classList.contains('dark-mode'));
                const btn = document.getElementById('btnToggleDark');
                const btnMob = document.getElementById('btnToggleDarkMobile');
                if (btn) btn.addEventListener('click', toggleTheme);
                if (btnMob) btnMob.addEventListener('click', toggleTheme);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
