@using System.Security.Claims
@using TicketsApp.Models
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Soporte TI | TecNM Monclova</title>
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Estilos personalizados TecNM -->
    <link rel="stylesheet" href="~/css/custom.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-tecnm py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Tickets" asp-action="Index">
                <img src="~/img/logo-horizontal.png" alt="TecNM Logo" height="42" class="me-3 bg-white p-1 rounded" />
                <div class="d-none d-sm-block border-start border-white border-opacity-25 ps-3">
                    <span class="fw-bold d-block text-white" style="font-size: 1.05rem; letter-spacing: 0.5px;">MESA DE AYUDA TI</span>
                    <small class="text-white-50" style="font-size: 0.75rem;">Campus Monclova</small>
                </div>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item me-1">
                            <a class="nav-link nav-link-custom" asp-controller="Tickets" asp-action="Index">
                                <i class="bi bi-grid-fill me-1 text-warning"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item me-1">
                            <a class="nav-link nav-link-custom" asp-controller="Tickets" asp-action="Crear">
                                <i class="bi bi-plus-circle-fill me-1 text-warning"></i>Nuevo Reporte
                            </a>
                        </li>
                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="GestionTecnicos">
                                    <i class="bi bi-person-badge-fill me-1 text-warning"></i>Técnicos
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle nav-link-custom d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <div class="bg-warning text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="text-start">
                                    <div class="fw-bold text-white small">@User.Identity.Name</div>
                                    <div class="text-white-50" style="font-size: 0.7rem;">@User.FindFirst(ClaimTypes.Role)?.Value</div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block">Correo Institucional:</small>
                                    <span class="fw-semibold small text-dark">@User.FindFirst(ClaimTypes.Email)?.Value</span>
                                </li>
                                <li class="p-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-2">
                                            <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item me-2">
                            <a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Ingresar
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-tecnm-gold btn-sm px-3" asp-controller="Account" asp-action="Registro">
                                <i class="bi bi-person-plus-fill me-1"></i>Registrarse
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container py-4 main-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 align-middle"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 align-middle"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </div>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <img src="~/img/logo-vertical.png" alt="TecNM" height="24" />
                <span>Instituto Tecnológico Superior de Monclova &copy; @DateTime.UtcNow.Year</span>
            </div>
            <div>
                <span class="badge bg-light text-secondary border">Mesa de Ayuda TI v1.0 MVP</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
