@model IEnumerable<TicketsApp.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Personal Técnico";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill me-2 text-primary"></i>Personal de Soporte Técnico</h3>
        <p class="text-muted mb-0 small">Alta, baja y control de estado de técnicos de la mesa de ayuda</p>
    </div>
    <button class="btn btn-tecnm-primary rounded-3" data-bs-toggle="modal" data-bs-target="#modalAltaTecnico">
        <i class="bi bi-person-plus-fill me-1"></i>Dar de Alta Nuevo Técnico
    </button>
</div>

<div class="card card-tecnm border-0 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-tecnm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Técnico</th>
                        <th>Correo Institucional</th>
                        <th>Fecha de Registro</th>
                        <th>Estado de Cuenta</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">No hay técnicos dados de alta en el sistema.</td>
                        </tr>
                    }
                    @foreach (var tec in Model)
                    {
                        <tr class="@(!tec.Activo ? "table-secondary text-muted" : "")">
                            <td class="fw-bold text-dark">
                                <i class="bi bi-person-badge me-2 @(tec.Activo ? "text-primary" : "text-secondary")"></i>@tec.NombreCompleto
                            </td>
                            <td><code>@tec.Email</code></td>
                            <td class="text-muted small">@tec.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (tec.Activo)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-1 rounded-pill">
                                        <i class="bi bi-check-circle-fill me-1"></i>Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-1 rounded-pill">
                                        <i class="bi bi-slash-circle me-1"></i>Dado de Baja
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="AlternarEstadoTecnico" method="post" class="d-inline">
                                    <input type="hidden" name="tecnicoId" value="@tec.Id" />
                                    @if (tec.Activo)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-2" onclick="return confirm('¿Seguro que deseas dar de baja a este técnico?');">
                                            <i class="bi bi-person-x me-1"></i>Dar de Baja
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-2">
                                            <i class="bi bi-person-check me-1"></i>Reactivar
                                        </button>
                                    }
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para Alta de Técnico -->
<div class="modal fade" id="modalAltaTecnico" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="AltaTecnico" method="post">
                <div class="modal-header text-white" style="background: var(--tecnm-accent-gradient); border-bottom: 3px solid var(--tecnm-gold);">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Registrar Nuevo Técnico</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Nombre Completo</label>
                        <input name="NombreCompleto" class="form-control form-control-custom" placeholder="Ej. Ing. Roberto Gómez" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Correo Institucional (@@monclova.tecnm.mx)</label>
                        <input name="Email" type="email" class="form-control form-control-custom" placeholder="roberto.gomez@monclova.tecnm.mx" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Contraseña</label>
                        <input name="Password" type="password" class="form-control form-control-custom" placeholder="••••••••" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-secondary text-uppercase">Confirmar Contraseña</label>
                        <input name="ConfirmPassword" type="password" class="form-control form-control-custom" placeholder="••••••••" required />
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary rounded-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-tecnm-primary rounded-3">Guardar y Habilitar</button>
                </div>
            </form>
        </div>
    </div>
</div>
