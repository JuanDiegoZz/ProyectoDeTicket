@model IEnumerable<TicketsApp.Models.Ticket>
@{
    ViewData["Title"] = "Cola de Soporte Técnico";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-wrench-adjustable me-2 text-primary"></i>Cola de Atención Técnica</h3>
        <p class="text-muted mb-0 small">Tickets asignados y solicitudes pendientes en campus</p>
    </div>

    <!-- Barra de búsqueda rápida para técnicos -->
    <div class="d-flex gap-2 align-items-center">
        <div class="input-group input-group-sm" style="max-width: 260px;">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input id="inputFiltroTecnico" type="text" class="form-control" placeholder="Buscar por folio, aula, falla..." />
        </div>
    </div>
</div>

<div class="card card-tecnm border-0 overflow-hidden shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaColaTecnico" class="table table-tecnm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Prioridad</th>
                        <th>Problema Reportado</th>
                        <th>Solicitante</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="bg-success bg-opacity-10 text-success p-3 rounded-circle d-inline-block mb-3">
                                    <i class="bi bi-check2-circle fs-1"></i>
                                </div>
                                <h5 class="fw-bold text-dark">Bandeja de atención al día</h5>
                                <p class="text-muted small">No hay tickets pendientes asignados ni en espera.</p>
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr class="fila-tecnico @(t.Prioridad == TicketsApp.Models.PrioridadTicket.Alta ? "table-danger-subtle" : "")">
                            <td class="fw-bold text-primary">#@t.Id</td>
                            <td>
                                @if (t.Prioridad == TicketsApp.Models.PrioridadTicket.Alta)
                                {
                                    <span class="badge-priority-alta"><i class="bi bi-lightning-charge-fill me-1"></i>Alta (Docente)</span>
                                }
                                else
                                {
                                    <span class="badge-priority-normal">Normal</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="fw-bold text-dark text-decoration-none d-block">
                                    @t.Titulo
                                </a>
                                <div class="small text-muted mb-1 text-truncate" style="max-width: 260px;">@t.Descripcion</div>
                                @if (!string.IsNullOrEmpty(t.RutaEvidencia))
                                {
                                    <span class="badge bg-light text-primary border"><i class="bi bi-paperclip me-1"></i>Evidencia adjunta</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small">@t.Solicitante?.NombreCompleto</div>
                                <small class="text-muted d-block" style="font-size: 0.75rem;">@t.Solicitante?.Email</small>
                            </td>
                            <td>
                                <span class="fw-bold">@t.Ubicacion?.Nombre</span>
                                @if (!string.IsNullOrEmpty(t.DetalleAula))
                                {
                                    <small class="text-muted d-block">@t.DetalleAula</small>
                                }
                            </td>
                            <td>
                                @switch (t.Estado)
                                {
                                    case TicketsApp.Models.EstadoTicket.Abierto:
                                        <span class="badge-status-abierto">Abierto</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.EnProgreso:
                                        <span class="badge-status-progreso">En Progreso</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.Resuelto:
                                        <span class="badge-status-resuelto">Resuelto</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="btn btn-sm btn-tecnm-primary px-3 rounded-2">
                                    <i class="bi bi-gear-fill me-1"></i>Atender
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("inputFiltroTecnico");
        const filas = document.querySelectorAll("#tablaColaTecnico tbody tr.fila-tecnico");

        if (input) {
            input.addEventListener("input", function () {
                const term = this.value.toLowerCase().trim();
                filas.forEach(f => {
                    f.style.display = f.textContent.toLowerCase().includes(term) ? "" : "none";
                });
            });
        }
    });
</script>
}
