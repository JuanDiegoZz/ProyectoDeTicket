@model IEnumerable<TicketsApp.Models.Ticket>
@{
    ViewData["Title"] = "Mis Solicitudes de Soporte";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-ticket-detailed me-2 text-primary"></i>Mis Reportes de Soporte</h3>
        <p class="text-muted mb-0 small">Monitorea el progreso, evidencias y notas de tus incidencias técnicas</p>
    </div>
    <div class="d-flex gap-2">
        <div class="input-group input-group-sm d-none d-sm-flex" style="max-width: 220px;">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input id="inputFiltroSolicitante" type="text" class="form-control" placeholder="Buscar mis tickets..." />
        </div>
        <a asp-action="Crear" class="btn btn-tecnm-primary rounded-3">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Reporte
        </a>
    </div>
</div>

<div class="card card-tecnm border-0 overflow-hidden shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaMisTickets" class="table table-tecnm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Detalle de la Falla</th>
                        <th>Categoría</th>
                        <th>Ubicación</th>
                        <th>Prioridad</th>
                        <th>Estado Actual</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="bg-light p-4 rounded-circle d-inline-block mb-3">
                                    <i class="bi bi-inbox fs-1 text-muted"></i>
                                </div>
                                <h5 class="fw-bold text-dark">No tienes incidencias registradas</h5>
                                <p class="text-muted small">Cuando reportes una falla técnica en aulas o laboratorios, podrás darle seguimiento aquí.</p>
                                <a asp-action="Crear" class="btn btn-tecnm-primary btn-sm px-4">Levantar mi primer ticket</a>
                            </td>
                        </tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr class="fila-solicitante">
                            <td class="fw-bold text-primary">#@t.Id</td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="fw-bold text-dark text-decoration-none d-block">
                                    @t.Titulo
                                </a>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 260px;">@t.Descripcion</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">@t.Categoria?.Nombre</span></td>
                            <td>
                                <span class="fw-semibold">@t.Ubicacion?.Nombre</span>
                                @if (!string.IsNullOrEmpty(t.DetalleAula))
                                {
                                    <small class="text-muted d-block">@t.DetalleAula</small>
                                }
                            </td>
                            <td>
                                @if (t.Prioridad == TicketsApp.Models.PrioridadTicket.Alta)
                                {
                                    <span class="badge-priority-alta"><i class="bi bi-lightning-fill me-1"></i>Alta</span>
                                }
                                else
                                {
                                    <span class="badge-priority-normal">Normal</span>
                                }
                            </td>
                            <td>
                                @switch (t.Estado)
                                {
                                    case TicketsApp.Models.EstadoTicket.Abierto:
                                        <span class="badge-status-abierto"><i class="bi bi-hourglass-split me-1"></i>Abierto</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.EnProgreso:
                                        <span class="badge-status-progreso"><i class="bi bi-gear-fill me-1"></i>En Atención</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.Resuelto:
                                        <span class="badge-status-resuelto"><i class="bi bi-check2-all me-1"></i>Resuelto</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary rounded-2">
                                    <i class="bi bi-eye me-1"></i>Ver Detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const input = document.getElementById("inputFiltroSolicitante");
        const filas = document.querySelectorAll("#tablaMisTickets tbody tr.fila-solicitante");

        if (input) {
            input.addEventListener("input", function () {
                const term = this.value.toLowerCase().trim();
                filas.forEach(f => {
                    f.style.display = f.textContent.toLowerCase().includes(term) ? "" : "none";
                });
            });
        }
    });
</script>
}
