@model TicketsApp.Domain.Entities.Ticket
@{
    ViewData["Title"] = $"Detalle del Ticket #{Model.Id}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-circle" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h3 class="fw-bold mb-0 text-dark">Ticket #@Model.Id: @Model.Titulo</h3>
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center text-muted small ms-md-4 ps-md-2">
            <span><i class="bi bi-calendar3 me-1"></i>Creado el @Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
            <span>&bull;</span>
            <span><i class="bi bi-person me-1"></i>Por @Model.Solicitante?.NombreCompleto</span>
        </div>
    </div>

    <!-- Acciones según estado y prioridad -->
    <div class="d-flex gap-2 align-items-center">
        @if (Model.Prioridad == TicketsApp.Domain.Enums.PrioridadTicket.Alta)
        {
            <span class="badge-priority-alta fs-6"><i class="bi bi-lightning-charge-fill me-1"></i>Prioridad Alta (Docente)</span>
        }
        else
        {
            <span class="badge-priority-normal fs-6">Prioridad Normal</span>
        }

        @switch (Model.Estado)
        {
            case TicketsApp.Domain.Enums.EstadoTicket.Abierto:
                <span class="badge-status-abierto fs-6"><i class="bi bi-hourglass-split me-1"></i>Abierto</span>
                break;
            case TicketsApp.Domain.Enums.EstadoTicket.EnProgreso:
                <span class="badge-status-progreso fs-6"><i class="bi bi-gear-fill me-1"></i>En Progreso</span>
                break;
            case TicketsApp.Domain.Enums.EstadoTicket.Resuelto:
                <span class="badge-status-resuelto fs-6"><i class="bi bi-check2-all me-1"></i>Resuelto</span>
                break;
            case TicketsApp.Domain.Enums.EstadoTicket.Cancelado:
                <span class="badge bg-danger text-white fs-6">Cancelado</span>
                break;
        }
    </div>
</div>

<!-- Módulo de Encuesta de Satisfacción (Si el ticket está Resuelto) -->
@if (Model.Estado == TicketsApp.Domain.Enums.EstadoTicket.Resuelto)
{
    @if (Model.CalificacionSatisfaccion.HasValue)
    {
        <div class="card card-tecnm border-0 mb-4 bg-light shadow-sm">
            <div class="card-body p-4 d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="fw-bold text-dark mb-1"><i class="bi bi-star-fill text-warning me-2"></i>Evaluación del Servicio:</h6>
                    <div class="text-warning fs-5">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Model.CalificacionSatisfaccion.Value)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                            else
                            {
                                <i class="bi bi-star"></i>
                            }
                        }
                        <span class="text-dark small ms-2 fw-bold">(@Model.CalificacionSatisfaccion de 5 estrellas)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ComentarioSatisfaccion))
                    {
                        <p class="text-muted small mb-0 mt-2">"<em>@Model.ComentarioSatisfaccion</em>"</p>
                    }
                </div>
                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill">
                    <i class="bi bi-patch-check-fill me-1"></i>Calificado
                </span>
            </div>
        </div>
    }
    else if (User.IsInRole("Solicitante"))
    {
        <div class="card card-tecnm border-0 mb-4 shadow-sm" style="border-left: 5px solid var(--tecnm-gold) !important;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-1"><i class="bi bi-stars text-warning me-2"></i>¿Cómo calificarías la atención recibida?</h5>
                <p class="text-muted small mb-3">Tu opinión nos ayuda a mejorar el servicio de soporte del TecNM Monclova.</p>
                <form asp-action="CalificarTicket" method="post">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-secondary">Calificación (Estrellas)</label>
                            <select name="estrellas" class="form-select form-select-custom">
                                <option value="5">⭐⭐⭐⭐⭐ Excelente (5)</option>
                                <option value="4">⭐⭐⭐⭐ Muy Bueno (4)</option>
                                <option value="3">⭐⭐⭐ Regular (3)</option>
                                <option value="2">⭐⭐ Malo (2)</option>
                                <option value="1">⭐ Pésimo (1)</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label small fw-bold text-secondary">Comentario u Observación (Opcional)</label>
                            <input name="comentario" class="form-control form-control-custom" placeholder="Ej. El técnico llegó rápido y resolvió el proyector..." />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-tecnm-gold w-100 fw-bold">Enviar</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
}

<div class="row g-4">
    <!-- Columna Principal: Detalle, Evidencia y Bitácora -->
    <div class="col-lg-8">
        <div class="card card-tecnm border-0 mb-4">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center">
                <i class="bi bi-card-text text-primary me-2 fs-5"></i>
                <h5 class="fw-bold mb-0 text-dark">Descripción de la Incidencia</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-dark fs-6" style="white-space: pre-line; line-height: 1.6;">@Model.Descripcion</p>

                @if (!string.IsNullOrEmpty(Model.RutaEvidencia))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 border">
                        <h6 class="fw-bold text-secondary small text-uppercase mb-3"><i class="bi bi-paperclip me-1 text-primary"></i>Evidencia Adjunta</h6>
                        @if (Model.RutaEvidencia.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="@Model.RutaEvidencia" target="_blank" class="btn btn-outline-primary">
                                <i class="bi bi-file-earmark-pdf-fill me-2 text-danger fs-5"></i>Ver Documento PDF Adjunto
                            </a>
                        }
                        else
                        {
                            <div class="text-center">
                                <a href="@Model.RutaEvidencia" target="_blank">
                                    <img src="@Model.RutaEvidencia" alt="Evidencia" class="img-fluid rounded-3 shadow-sm border" style="max-height: 350px;" />
                                </a>
                                <small class="text-muted d-block mt-2">Haz clic en la imagen para abrirla en tamaño completo</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Bitácora de Notas y Seguimiento Técnico -->
        <div class="card card-tecnm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <i class="bi bi-chat-left-text-fill text-primary me-2 fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Historial de Seguimiento y Notas</h5>
                </div>
                <span class="badge bg-light text-secondary border">@Model.Notas.Count notas</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="AgregarNota" method="post" class="mb-4">
                    <input type="hidden" name="ticketId" value="@Model.Id" />
                    <div class="input-group">
                        <textarea name="mensaje" class="form-control form-control-custom" rows="2" placeholder="Escribe una actualización o nota de seguimiento..." required></textarea>
                        <button type="submit" class="btn btn-tecnm-primary px-4 fw-bold">
                            <i class="bi bi-send-fill me-1"></i>Publicar
                        </button>
                    </div>
                </form>

                @if (!Model.Notas.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-square-dots fs-2 d-block mb-1 text-secondary"></i>
                        No hay notas registradas todavía.
                    </div>
                }
                else
                {
                    <div class="timeline">
                        @foreach (var nota in Model.Notas.OrderByDescending(n => n.FechaCreacion))
                        {
                            <div class="p-3 mb-3 rounded-3 bg-light border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-primary text-white fw-bold rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                            @(nota.Usuario?.NombreCompleto.Substring(0, 1).ToUpper() ?? "U")
                                        </div>
                                        <strong class="text-dark small">@nota.Usuario?.NombreCompleto</strong>
                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">@nota.Usuario?.Rol</span>
                                    </div>
                                    <small class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>@nota.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
                                </div>
                                <p class="mb-0 text-secondary small" style="white-space: pre-line;">@nota.Mensaje</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Columna Lateral: Control de Estado, Reasignación y Ficha Técnica -->
    <div class="col-lg-4">
        <!-- 1. Módulo de Reasignación de Técnicos (Exclusivo Administrador) -->
        @if (User.IsInRole("Administrador"))
        {
            <div class="card card-tecnm border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-flag-fill text-warning me-2"></i>Gestión de Prioridad</h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="CambiarPrioridad" method="post">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary text-uppercase">Nivel de Prioridad</label>
                            <select name="nuevaPrioridad" class="form-select form-select-custom">
                                <option value="Baja" selected="@(Model.Prioridad == TicketsApp.Domain.Enums.PrioridadTicket.Baja)">Baja</option>
                                <option value="Normal" selected="@(Model.Prioridad == TicketsApp.Domain.Enums.PrioridadTicket.Normal)">Normal (Alumno)</option>
                                <option value="Alta" selected="@(Model.Prioridad == TicketsApp.Domain.Enums.PrioridadTicket.Alta)">Alta (Docente)</option>
                                <option value="Urgente" selected="@(Model.Prioridad == TicketsApp.Domain.Enums.PrioridadTicket.Urgente)">Urgente</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-outline-warning w-100 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i>Actualizar Prioridad
                        </button>
                    </form>
                </div>
            </div>

            <div class="card card-tecnm border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-person-gear text-primary me-2"></i>Reasignación Técnica (Admin)</h6>
                </div>
                <div class="card-body p-3">
                    <form asp-action="ReasignarTecnico" method="post">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary text-uppercase">Asignar a:</label>
                            <select name="nuevoTecnicoId" asp-items="ViewBag.TecnicosDisponibles" class="form-select form-select-custom">
                                <option value="">-- Dejar sin asignar (Cola general) --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary text-uppercase">Motivo del cambio</label>
                            <input type="text" name="motivo" class="form-control form-control-custom" placeholder="Ej. Sobrecarga de trabajo..." />
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100 fw-bold">
                            <i class="bi bi-arrow-repeat me-1"></i>Reasignar Ticket
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- 2. Tarjeta de Gestión Técnica de Estado -->
        @if (User.IsInRole("Tecnico") || User.IsInRole("Administrador"))
        {
            <div class="card card-tecnm border-0 mb-4 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Cambio de Estado</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CambiarEstado" method="post">
                        <input type="hidden" name="ticketId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary text-uppercase">Nuevo Estado</label>
                            <select name="nuevoEstado" class="form-select form-select-custom">
                                <option value="Abierto" selected="@(Model.Estado == TicketsApp.Domain.Enums.EstadoTicket.Abierto)">Abierto</option>
                                <option value="EnProgreso" selected="@(Model.Estado == TicketsApp.Domain.Enums.EstadoTicket.EnProgreso)">En Progreso</option>
                                <option value="Resuelto" selected="@(Model.Estado == TicketsApp.Domain.Enums.EstadoTicket.Resuelto)">Resuelto</option>
                                <option value="Cancelado" selected="@(Model.Estado == TicketsApp.Domain.Enums.EstadoTicket.Cancelado)">Cancelado</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold small text-secondary text-uppercase">Nota del cambio</label>
                            <textarea name="nota" class="form-control form-control-custom" rows="2" placeholder="Detalles de la acción tomada..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-primary w-100 fw-bold">
                            <i class="bi bi-arrow-repeat me-1"></i>Actualizar Estado
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- 3. Ficha Técnica General -->
        <div class="card card-tecnm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Ficha Técnica</h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3 pb-3 border-bottom">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Categoría</small>
                    <span class="fw-bold text-dark"><i class="bi bi-tag-fill text-primary me-1"></i>@Model.Categoria?.Nombre</span>
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Ubicación / Campus</small>
                    <span class="fw-bold text-dark"><i class="bi bi-building me-1 text-danger"></i>@Model.Ubicacion?.Nombre</span>
                    @if (!string.IsNullOrEmpty(Model.DetalleAula))
                    {
                        <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>@Model.DetalleAula</div>
                    }
                </div>

                <div class="mb-3 pb-3 border-bottom">
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Solicitante</small>
                    <div class="fw-bold text-dark">@Model.Solicitante?.NombreCompleto</div>
                    <div class="small text-muted"><code>@Model.Solicitante?.Email</code></div>
                    <span class="badge bg-light text-dark border mt-1">@Model.Solicitante?.TipoSolicitante</span>
                </div>

                <div>
                    <small class="text-muted d-block text-uppercase fw-bold" style="font-size: 0.7rem;">Técnico Asignado</small>
                    @if (Model.TecnicoAsignado != null)
                    {
                        <div class="fw-bold text-success"><i class="bi bi-person-check-fill me-1"></i>@Model.TecnicoAsignado.NombreCompleto</div>
                        <div class="small text-muted"><code>@Model.TecnicoAsignado.Email</code></div>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Pendiente de Asignación</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
