@model TicketsApp.ViewModels.DashboardAdminViewModel
@{
    ViewData["Title"] = "Dashboard Administrador";
}

<!-- Encabezado del Dashboard -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="bg-white p-2 rounded-3 shadow-sm border">
            <img src="~/img/logo-vertical.png" alt="TecNM" height="48" />
        </div>
        <div>
            <h3 class="fw-bold mb-0 text-dark">Panel de Control TI</h3>
            <p class="text-muted mb-0 small">Métricas analíticas, auditoría y supervisión institucional</p>
        </div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ExportarCsv" class="btn btn-outline-success rounded-3 fw-semibold">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Exportar a Excel (CSV)
        </a>
        <a asp-controller="Account" asp-action="GestionTecnicos" class="btn btn-outline-primary rounded-3 fw-semibold">
            <i class="bi bi-people-fill me-1"></i>Gestionar Técnicos
        </a>
        <a asp-action="Crear" class="btn btn-tecnm-primary rounded-3">
            <i class="bi bi-plus-lg me-1"></i>Nuevo Ticket
        </a>
    </div>
</div>

<!-- KPIs Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card card-tecnm card-tecnm-hover p-3 border-0 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Total Tickets</div>
                    <div class="h2 fw-extrabold mb-0 text-dark">@Model.TotalTickets</div>
                </div>
                <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-ticket-detailed-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-tecnm card-tecnm-hover p-3 border-0 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Abiertos</div>
                    <div class="h2 fw-extrabold mb-0 text-warning">@Model.TicketsAbiertos</div>
                </div>
                <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-tecnm card-tecnm-hover p-3 border-0 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">En Progreso</div>
                    <div class="h2 fw-extrabold mb-0 text-info">@Model.TicketsEnProgreso</div>
                </div>
                <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card card-tecnm card-tecnm-hover p-3 border-0 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase">Resueltos</div>
                    <div class="h2 fw-extrabold mb-0 text-success">@Model.TicketsResueltos</div>
                </div>
                <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check2-circle"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECCIÓN DE GRÁFICAS INTERACTIVAS (Chart.js) -->
<div class="row g-4 mb-4">
    <!-- Gráfica 1: Distribución por Estado (Doughnut Chart) -->
    <div class="col-lg-4">
        <div class="card card-tecnm h-100 border-0 overflow-hidden shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Estado de Incidencias</h6>
                <span class="badge bg-light text-secondary border">General</span>
            </div>
            <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center" style="min-height: 280px;">
                <div style="position: relative; height: 230px; width: 100%;">
                    <canvas id="chartEstados"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfica 2: Fallas por Edificio / Área (Bar Chart) -->
    <div class="col-lg-4">
        <div class="card card-tecnm h-100 border-0 overflow-hidden shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-fill text-danger me-2"></i>Fallas por Edificio</h6>
                <span class="badge bg-light text-secondary border">Ubicación</span>
            </div>
            <div class="card-body p-3" style="min-height: 280px;">
                <div style="position: relative; height: 230px; width: 100%;">
                    <canvas id="chartUbicaciones"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Gráfica 3: Fallas por Categoría (Polar / Horizontal Bar Chart) -->
    <div class="col-lg-4">
        <div class="card card-tecnm h-100 border-0 overflow-hidden shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-tags-fill text-warning me-2"></i>Fallas por Categoría</h6>
                <span class="badge bg-light text-secondary border">Tipo de Servicio</span>
            </div>
            <div class="card-body p-3" style="min-height: 280px;">
                <div style="position: relative; height: 230px; width: 100%;">
                    <canvas id="chartCategorias"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SECCIÓN DE DETALLES: Eficiencia y Solicitantes -->
<div class="row g-4 mb-4">
    <!-- Eficiencia de Técnicos -->
    <div class="col-lg-6">
        <div class="card card-tecnm h-100 border-0 overflow-hidden shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-person-check-fill text-primary me-2"></i>Rendimiento del Personal Técnico</h6>
                <span class="badge bg-light text-secondary border">Eficiencia</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-tecnm mb-0">
                        <thead>
                            <tr>
                                <th>Técnico</th>
                                <th class="text-center">En Atención</th>
                                <th class="text-center">Resueltos</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.EficienciaTecnicos.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">No hay técnicos asignados aún</td></tr>
                            }
                            @foreach (var tec in Model.EficienciaTecnicos)
                            {
                                <tr>
                                    <td class="fw-bold text-dark"><i class="bi bi-person-badge me-2 text-primary"></i>@tec.Nombre</td>
                                    <td class="text-center"><span class="badge-status-progreso">@tec.EnProgreso</span></td>
                                    <td class="text-center"><span class="badge-status-resuelto">@tec.Resueltos</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Top Solicitantes -->
    <div class="col-lg-6">
        <div class="card card-tecnm h-100 border-0 overflow-hidden shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-info me-2"></i>Top Usuarios con Más Reportes</h6>
                <span class="badge bg-light text-secondary border">Actividad</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-tecnm mb-0">
                        <thead>
                            <tr>
                                <th>Usuario Solicitante</th>
                                <th class="text-end">Total Reportes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.TopSolicitantes.Any())
                            {
                                <tr><td colspan="2" class="text-center text-muted py-4">No hay datos de reportes aún</td></tr>
                            }
                            @foreach (var sol in Model.TopSolicitantes)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@sol.Nombre</div>
                                        <small class="text-muted"><code>@sol.Email</code></small>
                                    </td>
                                    <td class="text-end">
                                        <span class="badge bg-dark text-white rounded-pill px-3 py-1">@sol.TotalReportados</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla Interactiva con Buscador y Filtros en Vivo -->
<div class="card card-tecnm border-0 overflow-hidden shadow-sm">
    <div class="card-header bg-white py-3 border-bottom">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-table text-primary me-2"></i>Todas las Incidencias del Campus</h6>
            
            <!-- Barra de Filtro y Búsqueda en Vivo -->
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="input-group input-group-sm" style="max-width: 250px;">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input id="inputFiltroBusqueda" type="text" class="form-control" placeholder="Buscar folio, solicitante, falla..." />
                </div>
                <select id="selectFiltroEstado" class="form-select form-select-sm" style="width: 140px;">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Abierto">Abiertos</option>
                    <option value="EnProgreso">En Progreso</option>
                    <option value="Resuelto">Resueltos</option>
                </select>
                <select id="selectFiltroPrioridad" class="form-select form-select-sm" style="width: 150px;">
                    <option value="">-- Prioridades --</option>
                    <option value="Alta">Alta (Docente)</option>
                    <option value="Normal">Normal (Alumno)</option>
                </select>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="tablaTicketsAdmin" class="table table-tecnm table-hover mb-0">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Problema / Falla</th>
                        <th>Solicitante</th>
                        <th>Ubicación</th>
                        <th>Técnico Asignado</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.UltimosTickets.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay tickets registrados aún en el sistema.</td></tr>
                    }
                    @foreach (var t in Model.UltimosTickets)
                    {
                        <tr class="ticket-row" data-estado="@t.Estado" data-prioridad="@t.Prioridad">
                            <td class="fw-bold text-primary">#@t.Id</td>
                            <td>
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="fw-bold text-dark text-decoration-none">
                                    @t.Titulo
                                </a>
                                <small class="text-muted d-block text-truncate" style="max-width: 220px;">@t.Descripcion</small>
                            </td>
                            <td>
                                <div class="fw-semibold small">@t.Solicitante?.NombreCompleto</div>
                                <span class="text-muted" style="font-size: 0.75rem;">@t.Solicitante?.Email</span>
                            </td>
                            <td>
                                <span class="fw-semibold">@t.Ubicacion?.Nombre</span>
                                @if (!string.IsNullOrEmpty(t.DetalleAula))
                                {
                                    <small class="text-muted d-block">@t.DetalleAula</small>
                                }
                            </td>
                            <td>
                                @if (t.TecnicoAsignado != null)
                                {
                                    <span class="small fw-semibold text-dark"><i class="bi bi-person-check me-1 text-success"></i>@t.TecnicoAsignado.NombreCompleto</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Sin asignar</span>
                                }
                            </td>
                            <td>
                                @if (t.Prioridad == TicketsApp.Models.PrioridadTicket.Alta)
                                {
                                    <span class="badge-priority-alta"><i class="bi bi-lightning-charge-fill me-1"></i>Alta</span>
                                }
                                else
                                {
                                    <span class="badge-priority-normal">Normal</span>
                                }
                            </td>
                            <td>
                                @switch (t.Estado)
                                {
                                    case TicketsApp.Models.EstadoTicket.Abierto:
                                        <span class="badge-status-abierto">Abierto</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.EnProgreso:
                                        <span class="badge-status-progreso">En Progreso</span>
                                        break;
                                    case TicketsApp.Models.EstadoTicket.Resuelto:
                                        <span class="badge-status-resuelto">Resuelto</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Detalle" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary rounded-2">
                                    <i class="bi bi-eye-fill me-1"></i>Ver Detalle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<!-- Librería Oficial Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // ==========================================
        // 1. Gráfica de Estados (Doughnut)
        // ==========================================
        const ctxEstados = document.getElementById('chartEstados');
        if (ctxEstados) {
            new Chart(ctxEstados, {
                type: 'doughnut',
                data: {
                    labels: ['Abiertos', 'En Progreso', 'Resueltos'],
                    datasets: [{
                        data: [@Model.TicketsAbiertos, @Model.TicketsEnProgreso, @Model.TicketsResueltos],
                        backgroundColor: ['#F59E0B', '#0284C7', '#10B981'],
                        borderWidth: 2,
                        borderColor: '#ffffff',
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 14,
                                font: { family: 'Plus Jakarta Sans', size: 12 }
                            }
                        }
                    },
                    cutout: '70%'
                }
            });
        }

        // ==========================================
        // 2. Gráfica de Ubicaciones / Edificios (Bar Chart)
        // ==========================================
        const ctxUbicaciones = document.getElementById('chartUbicaciones');
        if (ctxUbicaciones) {
            const labelsUbicaciones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FallasPorUbicacion.Select(x => x.Ubicacion)));
            const dataUbicaciones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FallasPorUbicacion.Select(x => x.Cantidad)));

            new Chart(ctxUbicaciones, {
                type: 'bar',
                data: {
                    labels: labelsUbicaciones,
                    datasets: [{
                        label: 'Tickets Reportados',
                        data: dataUbicaciones,
                        backgroundColor: '#1B396A',
                        borderRadius: 6,
                        hoverBackgroundColor: '#D4AF37'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, font: { family: 'Plus Jakarta Sans' } },
                            grid: { color: '#F1F5F9' }
                        },
                        x: {
                            ticks: { font: { family: 'Plus Jakarta Sans', weight: '600' } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // ==========================================
        // 3. Gráfica de Categorías (Horizontal Bar Chart)
        // ==========================================
        const ctxCategorias = document.getElementById('chartCategorias');
        if (ctxCategorias) {
            const labelsCategorias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FallasPorCategoria.Select(x => x.Categoria)));
            const dataCategorias = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FallasPorCategoria.Select(x => x.Cantidad)));

            new Chart(ctxCategorias, {
                type: 'bar',
                data: {
                    labels: labelsCategorias,
                    datasets: [{
                        label: 'Tickets',
                        data: dataCategorias,
                        backgroundColor: '#D4AF37',
                        borderRadius: 6,
                        hoverBackgroundColor: '#1B396A'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, font: { family: 'Plus Jakarta Sans' } },
                            grid: { color: '#F1F5F9' }
                        },
                        y: {
                            ticks: { font: { family: 'Plus Jakarta Sans', weight: '600' } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // ==========================================
        // 4. Filtro y Buscador en Vivo
        // ==========================================
        const inputBusqueda = document.getElementById("inputFiltroBusqueda");
        const selectEstado = document.getElementById("selectFiltroEstado");
        const selectPrioridad = document.getElementById("selectFiltroPrioridad");
        const rows = document.querySelectorAll("#tablaTicketsAdmin tbody tr.ticket-row");

        function filtrarTabla() {
            const texto = inputBusqueda.value.toLowerCase().trim();
            const estadoFiltro = selectEstado.value;
            const prioridadFiltro = selectPrioridad.value;

            rows.forEach(row => {
                const contenidoFila = row.textContent.toLowerCase();
                const estado = row.getAttribute("data-estado");
                const prioridad = row.getAttribute("data-prioridad");

                const coincideTexto = !texto || contenidoFila.includes(texto);
                const coincideEstado = !estadoFiltro || estado === estadoFiltro;
                const coincidePrioridad = !prioridadFiltro || prioridad === prioridadFiltro;

                if (coincideTexto && coincideEstado && coincidePrioridad) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        if (inputBusqueda) inputBusqueda.addEventListener("input", filtrarTabla);
        if (selectEstado) selectEstado.addEventListener("change", filtrarTabla);
        if (selectPrioridad) selectPrioridad.addEventListener("change", filtrarTabla);
    });
</script>
}
