@model TicketsApp.ViewModels.CrearTicketViewModel
@{
    ViewData["Title"] = "Nuevo Reporte de Incidencia";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-9">
        <div class="card card-tecnm shadow-sm border-0 overflow-hidden">
            <div class="p-4 text-white d-flex align-items-center justify-content-between" style="background: var(--tecnm-accent-gradient); border-bottom: 3px solid var(--tecnm-gold);">
                <div class="d-flex align-items-center">
                    <div class="bg-white p-2 rounded-3 me-3">
                        <img src="~/img/logo-vertical.png" alt="TecNM" height="45" />
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Levantar Ticket de Soporte</h4>
                        <small class="text-white-50">Describe tu problema técnico para asignarle atención inmediata</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Crear" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3 border-0"></div>

                    <div class="mb-4">
                        <label asp-for="Titulo" class="form-label fw-bold text-secondary small text-uppercase"></label>
                        <input asp-for="Titulo" class="form-control form-control-custom" placeholder="Ej. Proyector no enciende / Sin señal de Internet en laboratorio" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-bold text-secondary small text-uppercase"></label>
                            <select asp-for="CategoriaId" class="form-select form-select-custom" asp-items="ViewBag.Categorias">
                                <option value="">-- Seleccionar Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UbicacionId" class="form-label fw-bold text-secondary small text-uppercase"></label>
                            <select asp-for="UbicacionId" class="form-select form-select-custom" asp-items="ViewBag.Ubicaciones">
                                <option value="">-- Seleccionar Edificio / Área --</option>
                            </select>
                            <span asp-validation-for="UbicacionId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="DetalleAula" class="form-label fw-bold text-secondary small text-uppercase"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-geo-alt-fill text-danger"></i></span>
                            <input asp-for="DetalleAula" class="form-control form-control-custom" placeholder="Ej. Aula 204 planta alta, Laboratorio de Redes 2, Cubículo 5..." />
                        </div>
                        <span asp-validation-for="DetalleAula" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-bold text-secondary small text-uppercase"></label>
                        <textarea asp-for="Descripcion" class="form-control form-control-custom" rows="4" placeholder="Detalla qué estabas realizando, síntomas del fallo o mensajes de error que muestra la pantalla..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <!-- Input para Subida de Evidencia Fotográfica -->
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <label asp-for="ArchivoEvidencia" class="form-label fw-bold text-dark d-flex align-items-center">
                            <i class="bi bi-camera-fill text-primary me-2 fs-5"></i>Evidencia Fotográfica o Captura de Pantalla (Opcional)
                        </label>
                        <input asp-for="ArchivoEvidencia" type="file" class="form-control form-control-custom bg-white" accept="image/*,.pdf" />
                        <small class="text-muted mt-1 d-block">Archivos permitidos: JPG, PNG, WEBP o PDF. Se guardará de forma segura en el servidor.</small>
                        <span asp-validation-for="ArchivoEvidencia" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-3">
                            <i class="bi bi-arrow-left me-1"></i>Regresar
                        </a>
                        <button type="submit" class="btn btn-tecnm-primary px-5 py-2 fw-bold">
                            <i class="bi bi-send-fill me-2"></i>Enviar Reporte
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
